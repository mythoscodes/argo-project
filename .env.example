# ============================================
# Argos — 환경변수 템플릿
# .env.local에 복사 후 실제 값 입력
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# --- AI Model ---
# 옵션 A (기본): gemini-3-flash  ($0, 무료)
# 옵션 B (하이브리드): 기능별 분리 (AI_MODEL_QUIZ, AI_MODEL_COACHING)
# 옵션 C (품질): claude-sonnet   (~$10)
AI_MODEL=gemini-3-flash

# --- 옵션 B 하이브리드 (필요 시 주석 해제) ---
# AI_MODEL_QUIZ=claude-sonnet
# AI_MODEL_COACHING=gemini-3-flash
# AI_MODEL_ANALYSIS=gemini-3-flash
# AI_MODEL_REPORT=gemini-3-flash
# AI_MODEL_MENTOR_BRIEFING=gemini-3-flash

# --- Google Gemini (옵션 A/B) ---
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key

# --- Anthropic Claude (옵션 B/C에서만 필요) ---
# ANTHROPIC_API_KEY=your-anthropic-key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
